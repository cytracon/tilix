#!/usr/bin/env bash
# Omarchy theme-set hook: map the current theme's colors.toml onto the
# default Tilix profile. Installed as ~/.config/omarchy/hooks/theme-set.d/theme-set-tilix
set -euo pipefail

THEME_SLUG="${1:-}"
HOME_DIR="${HOME:-/home/bbachmann}"
PREFIX="${TILIX_PREFIX:-$HOME_DIR/.local}"
export GSETTINGS_SCHEMA_DIR="${PREFIX}/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
export XDG_DATA_DIRS="${PREFIX}/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

if ! command -v gsettings >/dev/null 2>&1; then
  exit 0
fi
if ! command -v python3 >/dev/null 2>&1; then
  exit 0
fi

colors=""
for candidate in \
  "${HOME_DIR}/.config/omarchy/current/theme/colors.toml" \
  "${HOME_DIR}/.config/omarchy/themes/${THEME_SLUG}/colors.toml"
do
  if [[ -n "${candidate}" && -f "${candidate}" ]]; then
    colors="${candidate}"
    break
  fi
done
[[ -n "${colors}" ]] || exit 0

python3 - "$colors" << 'PY'
import os, re, subprocess, sys

path = sys.argv[1]
vals = {}
key_re = re.compile(r'^([A-Za-z0-9_]+)\s*=\s*"([^"]+)"')
with open(path, encoding="utf-8") as fh:
    for line in fh:
        m = key_re.match(line.strip())
        if m:
            vals[m.group(1)] = m.group(2)

def c(*names, default="#000000"):
    for n in names:
        if n in vals and vals[n]:
            return vals[n]
    return default

bg = c("background")
fg = c("foreground", "bright_foreground")
palette = [
    c("background"),
    c("red"),
    c("green"),
    c("yellow"),
    c("blue"),
    c("magenta", "purple"),
    c("cyan"),
    c("foreground"),
    c("muted", "dark_foreground"),
    c("bright_red", "red"),
    c("bright_green", "green"),
    c("bright_yellow", "yellow"),
    c("bright_blue", "blue"),
    c("bright_magenta", "magenta", "purple"),
    c("bright_cyan", "cyan"),
    c("bright_foreground", "light_foreground", "foreground"),
]

def gs(*args):
    env = os.environ.copy()
    subprocess.run(["gsettings", *args], check=False, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

uuid = subprocess.check_output(
    ["gsettings", "get", "com.gexperts.Tilix.ProfilesList", "default"],
    text=True,
).strip().strip("'\"")
if not uuid or uuid.startswith("@"):
    sys.exit(0)
base = f"com.gexperts.Tilix.Profile:/com/gexperts/Tilix/profiles/{uuid}/"
gs("set", base, "use-theme-colors", "false")
gs("set", base, "background-color", f"'{bg}'")
gs("set", base, "foreground-color", f"'{fg}'")
pal = "[" + ", ".join(f"'{p}'" for p in palette) + "]"
gs("set", base, "palette", pal)

mode = vals.get("mode", "").lower()
if mode in ("dark", "light"):
    gs("set", "com.gexperts.Tilix", "theme-variant", mode)
PY
